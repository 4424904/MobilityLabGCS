<RCC>
    <!-- QML overrides: qrc:/qml/X is replaced by qrc:/Custom/qml/X (see MLOverrideInterceptor) -->
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/FlyView/FlyView.qml">qml/overrides/FlyView.qml</file>
        <file alias="QGroundControl/Toolbar/FlyViewToolBar.qml">qml/overrides/FlyViewToolBar.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewCustomLayer.qml">qml/overrides/FlyViewCustomLayer.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewBottomRightRowLayout.qml">qml/overrides/FlyViewBottomRightRowLayout.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewTopRightPanel.qml">qml/overrides/FlyViewTopRightPanel.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewToolStripActionList.qml">qml/overrides/FlyViewToolStripActionList.qml</file>
        <file alias="QGroundControl/FlyView/GuidedActionConfirm.qml">qml/overrides/GuidedActionConfirm.qml</file>
        <file alias="QGroundControl/PlanView/PlanView.qml">qml/overrides/PlanView.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewMissionCompleteDialog.qml">qml/overrides/FlyViewMissionCompleteDialog.qml</file>
    </qresource>
    <!-- Branding overrides -->
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="QGCLogoWhite.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="qgroundcontrol.ico">deploy/windows/MobilityLabGCS.ico</file>
    </qresource>
    <!-- MobilityLab resources -->
    <qresource prefix="/MobilityLab">
        <file alias="tandem.json">res/tandem.json</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="fonts/IBMPlexSansKR-Regular.ttf">res/fonts/IBMPlexSansKR-Regular.ttf</file>
        <file alias="fonts/IBMPlexSansKR-SemiBold.ttf">res/fonts/IBMPlexSansKR-SemiBold.ttf</file>
        <file alias="fonts/IBMPlexMono-Regular.ttf">res/fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="fonts/IBMPlexMono-Medium.ttf">res/fonts/IBMPlexMono-Medium.ttf</file>
        <file alias="logo.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="icons/takeoff.svg">res/icons/takeoff.svg</file>
        <file alias="icons/land.svg">res/icons/land.svg</file>
        <file alias="icons/rtl.svg">res/icons/rtl.svg</file>
        <file alias="icons/pause.svg">res/icons/pause.svg</file>
        <file alias="icons/play.svg">res/icons/play.svg</file>
        <file alias="icons/arm.svg">res/icons/arm.svg</file>
        <file alias="icons/kill.svg">res/icons/kill.svg</file>
        <file alias="icons/abort.svg">res/icons/abort.svg</file>
        <file alias="icons/collapse.svg">res/icons/collapse.svg</file>
        <file alias="ui/area.svg">res/icons/ui/area.svg</file>
        <file alias="ui/bell.svg">res/icons/ui/bell.svg</file>
        <file alias="ui/records.svg">res/icons/ui/records.svg</file>
        <file alias="ui/gear.svg">res/icons/ui/gear.svg</file>
        <file alias="ui/help.svg">res/icons/ui/help.svg</file>
        <file alias="ui/keyboard.svg">res/icons/ui/keyboard.svg</file>
        <file alias="ui/play.svg">res/icons/ui/play.svg</file>
        <file alias="ui/fullscreen.svg">res/icons/ui/fullscreen.svg</file>
        <file alias="ui/exitfull.svg">res/icons/ui/exitfull.svg</file>
        <file alias="ui/shield.svg">res/icons/ui/shield.svg</file>
        <file alias="ui/pulse.svg">res/icons/ui/pulse.svg</file>
        <file alias="ui/check.svg">res/icons/ui/check.svg</file>
        <file alias="ui/checklist.svg">res/icons/ui/checklist.svg</file>
        <file alias="ui/close.svg">res/icons/ui/close.svg</file>
        <file alias="ui/console.svg">res/icons/ui/console.svg</file>
        <file alias="ui/cube.svg">res/icons/ui/cube.svg</file>
        <file alias="ui/detach.svg">res/icons/ui/detach.svg</file>
        <file alias="ui/download.svg">res/icons/ui/download.svg</file>
        <file alias="ui/fit.svg">res/icons/ui/fit.svg</file>
        <file alias="ui/follow.svg">res/icons/ui/follow.svg</file>
        <file alias="ui/layers.svg">res/icons/ui/layers.svg</file>
        <file alias="ui/layout.svg">res/icons/ui/layout.svg</file>
        <file alias="ui/left.svg">res/icons/ui/left.svg</file>
        <file alias="ui/minus.svg">res/icons/ui/minus.svg</file>
        <file alias="ui/moon.svg">res/icons/ui/moon.svg</file>
        <file alias="ui/pin.svg">res/icons/ui/pin.svg</file>
        <file alias="ui/plus.svg">res/icons/ui/plus.svg</file>
        <file alias="ui/radar.svg">res/icons/ui/radar.svg</file>
        <file alias="ui/refresh.svg">res/icons/ui/refresh.svg</file>
        <file alias="ui/right.svg">res/icons/ui/right.svg</file>
        <file alias="ui/ruler.svg">res/icons/ui/ruler.svg</file>
        <file alias="ui/search.svg">res/icons/ui/search.svg</file>
        <file alias="ui/star.svg">res/icons/ui/star.svg</file>
        <file alias="ui/sun.svg">res/icons/ui/sun.svg</file>
        <file alias="ui/target.svg">res/icons/ui/target.svg</file>
        <file alias="ui/timeline.svg">res/icons/ui/timeline.svg</file>
        <file alias="ui/trash.svg">res/icons/ui/trash.svg</file>
        <file alias="ui/undo.svg">res/icons/ui/undo.svg</file>
    </qresource>
</RCC>

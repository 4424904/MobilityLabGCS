<RCC>
    <!-- QML overrides: qrc:/qml/X is replaced by qrc:/Custom/qml/X (see MLOverrideInterceptor) -->
    <qresource prefix="/Custom/qml">
        <file alias="QGroundControl/FlyView/FlyView.qml">qml/overrides/FlyView.qml</file>
        <file alias="QGroundControl/Toolbar/FlyViewToolBar.qml">qml/overrides/FlyViewToolBar.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewCustomLayer.qml">qml/overrides/FlyViewCustomLayer.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewBottomRightRowLayout.qml">qml/overrides/FlyViewBottomRightRowLayout.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewTopRightPanel.qml">qml/overrides/FlyViewTopRightPanel.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewToolStripActionList.qml">qml/overrides/FlyViewToolStripActionList.qml</file>
        <file alias="QGroundControl/FlyView/GuidedActionConfirm.qml">qml/overrides/GuidedActionConfirm.qml</file>
    </qresource>
    <!-- Branding overrides -->
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="QGCLogoWhite.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="qgroundcontrol.ico">deploy/windows/MobilityLabGCS.ico</file>
    </qresource>
    <!-- MobilityLab resources -->
    <qresource prefix="/MobilityLab">
        <file alias="tandem.json">res/tandem.json</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="fonts/IBMPlexSansKR-Regular.ttf">res/fonts/IBMPlexSansKR-Regular.ttf</file>
        <file alias="fonts/IBMPlexSansKR-SemiBold.ttf">res/fonts/IBMPlexSansKR-SemiBold.ttf</file>
        <file alias="fonts/IBMPlexMono-Regular.ttf">res/fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="fonts/IBMPlexMono-Medium.ttf">res/fonts/IBMPlexMono-Medium.ttf</file>
        <file alias="logo.svg">res/icons/MobilityLabLogo.svg</file>
        <file alias="icons/takeoff.svg">res/icons/takeoff.svg</file>
        <file alias="icons/land.svg">res/icons/land.svg</file>
        <file alias="icons/rtl.svg">res/icons/rtl.svg</file>
        <file alias="icons/pause.svg">res/icons/pause.svg</file>
        <file alias="icons/play.svg">res/icons/play.svg</file>
        <file alias="icons/arm.svg">res/icons/arm.svg</file>
        <file alias="icons/kill.svg">res/icons/kill.svg</file>
        <file alias="icons/abort.svg">res/icons/abort.svg</file>
        <file alias="icons/collapse.svg">res/icons/collapse.svg</file>
    </qresource>
</RCC>

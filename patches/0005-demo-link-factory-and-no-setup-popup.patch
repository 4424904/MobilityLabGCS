--- a/src/Comms/LinkManager.h
+++ b/src/Comms/LinkManager.h
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <functional>
+
 #include <QtCore/QList>
 #include <QtCore/QMutex>
 #include <QtCore/QMutexLocker>
@@ -84,6 +86,15 @@ class LinkManager : public QObject
     /// Creates, connects (and adds) a link  based on the given configuration instance.
     bool createConnectedLink(SharedLinkConfigurationPtr &config);
 
+    /// MobilityLab: links of types QGC does not build itself (in-process demo vehicles). The factory is
+    /// asked for any configuration whose type() is TypeLast.
+    using CustomLinkFactory = std::function<SharedLinkInterfacePtr(SharedLinkConfigurationPtr &)>;
+    static void setCustomLinkFactory(CustomLinkFactory factory) { _customLinkFactory = std::move(factory); }
+    /// MobilityLab: while set, a link is only created when the gate returns true (demo mode keeps every
+    /// real link — UDP, serial, TCP, Bluetooth, auto-connect — closed, so no command can reach an aircraft).
+    using LinkGate = std::function<bool(const SharedLinkConfigurationPtr &)>;
+    static void setLinkGate(LinkGate gate) { _linkGate = std::move(gate); }
+
     /// Returns pointer to the mavlink forwarding link, or nullptr if it does not exist
     SharedLinkInterfacePtr mavlinkForwardingLink();
 
@@ -148,6 +159,8 @@ private slots:
